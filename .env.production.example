# ==============================================================================
# JewelCore Luxury Atelier ERP — Production Environment Configuration
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# PostgreSQL 16 Enterprise Database
POSTGRES_USER=jewelcore
POSTGRES_PASSWORD=jewelcore_secure_production_pwd_2026
POSTGRES_DB=jewelcore_erp
POSTGRES_PORT=5434
DATABASE_URL=postgres://jewelcore:jewelcore_secure_production_pwd_2026@postgres:5432/jewelcore_erp

# Redis 7 Distributed Cache & Hardware Telemetry Mesh
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptography & HSM Quorum Authentication
JWT_SECRET=jewelcore_argon2id_hsm_master_secret_key_production_2026
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
STORAGE_SIGNING_SECRET=jewelcore-object-storage-signature-key-2026

# Cross-Origin & Client Routing
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hardware Telemetry & Commodity Exchange Ingestion
MCX_COMMODITY_FEED_URL=https://api.mcxindia.com/marketdata/feed
TELEMETRY_SAMPLE_RATE_MS=2000
LOG_LEVEL=info
