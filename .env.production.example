# ==============================================================================
# JewelCore Luxury Atelier ERP — Production Environment Configuration
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# PostgreSQL 16 Enterprise Database
POSTGRES_USER=jewelcore
POSTGRES_PASSWORD=jewelcore_secure_production_pwd_2026
POSTGRES_DB=jewelcore_erp
POSTGRES_PORT=5434
DATABASE_URL=postgres://jewelcore:jewelcore_secure_production_pwd_2026@postgres:5432/jewelcore_erp

# Redis 7 Distributed Cache & Hardware Telemetry Mesh
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptography & HSM Quorum Authentication
JWT_SECRET=jewelcore_argon2id_hsm_master_secret_key_production_2026
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
STORAGE_SIGNING_SECRET=jewelcore-object-storage-signature-key-2026

# S3 / MinIO Object Storage (BIS Hallmarking Dossiers, GIA Reports & KYC)
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_BUCKET=jewelcore-production-vault-assets
AWS_ACCESS_KEY_ID=AKIA_JEWELCORE_PROD_VAULT_KEY
AWS_SECRET_ACCESS_KEY=secure_aws_secret_key_production_vault_999

# Statutory Indian Jewelry Compliance (NIC GST E-Invoice & E-Way Bill)
GSTIN=27AABCU9603R1ZM
NIC_CLIENT_ID=jewelcore_nic_production_client
NIC_CLIENT_SECRET=secure_nic_production_client_secret_2026

# Zero Trust Network Perimeter & Geofencing CIDR
SHOWROOM_ALLOWED_CIDR=192.168.1.0/24,10.0.10.0/24

# Cross-Origin & Client Routing
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hardware Telemetry & Commodity Exchange Ingestion
MCX_COMMODITY_FEED_URL=https://api.mcxindia.com/marketdata/feed
TELEMETRY_SAMPLE_RATE_MS=2000
LOG_LEVEL=info
