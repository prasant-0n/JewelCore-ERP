# ==============================================================================
# JewelCore Luxury Atelier ERP - Production Environment Configuration Blueprint
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL 18 Alpine / Multi-Tenant Isolation)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jewelcore
POSTGRES_PASSWORD=replace_with_secure_production_pg_password_here
POSTGRES_DB=jewelcore_erp
DATABASE_URL=postgres://jewelcore:replace_with_secure_production_pg_password_here@postgres:5432/jewelcore_erp

# Redis (Redis 7.2 Alpine / BullMQ Worker Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Cryptographic Signatures & Security
JWT_SECRET=replace_with_ultra_secure_entropy_key_minimum_32_characters_long!
CORS_ORIGIN=https://atelier.jewelcore.luxury

# Service Ports
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.jewelcore.luxury/api/v1
