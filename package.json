{
  "name": "jewelcore-erp",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build:shared": "pnpm --filter \"@jewelcore/shared\" run build",
    "build": "pnpm --filter \"@jewelcore/shared\" run build && pnpm --filter \"@jewelcore/*\" run build",
    "typecheck": "pnpm --filter \"@jewelcore/shared\" run build && pnpm --filter \"@jewelcore/*\" run typecheck",
    "test": "vitest run",
    "test:load": "tsx load-tests/showroom-concurrency.ts",
    "test:e2e": "pnpm --filter \"@jewelcore/web\" run test:e2e",
    "validate:cloud": "tsx scripts/validate-cloud-orchestration.ts",
    "db:seed": "pnpm --filter \"@jewelcore/database\" run seed",
    "dev:api": "pnpm --filter \"@jewelcore/api\" run dev",
    "dev:web": "pnpm --filter \"@jewelcore/web\" run dev",
    "dev:all": "pnpm --parallel --filter \"@jewelcore/api\" --filter \"@jewelcore/web\" run dev",
    "format": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.9.1"
  }
}
